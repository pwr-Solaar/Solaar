#: lib/logitech_receiver/settings_templates.py:183
msgid "Swap Fx function"
msgstr "Växla F-tangenternas funktion"

#: lib/logitech_receiver/settings_templates.py:186
msgid ""
"When set, the F1..F12 keys will activate their special function,\n"
"and you must hold the FN key to activate their standard function."
msgstr ""
"När detta är aktiverat använder F1–F12-tangenterna sina specialfunktioner,\n"
"och du måste hålla ned FN-tangenten för att använda deras standardfunktioner."

#: lib/logitech_receiver/settings_templates.py:191
msgid ""
"When unset, the F1..F12 keys will activate their standard function,\n"
"and you must hold the FN key to activate their special function."
msgstr ""
"När detta är inaktiverat använder F1–F12-tangenterna sina standardfunktioner,\n"
"och du måste hålla ned FN-tangenten för att använda deras specialfunktioner."

#: lib/logitech_receiver/settings_templates.py:199
msgid "Hand Detection"
msgstr "Handavkänning"

#: lib/logitech_receiver/settings_templates.py:200
msgid "Turn on illumination when the hands hover over the keyboard."
msgstr "Tänd belysning när händerna hålls över tangentbordet."

#: lib/logitech_receiver/settings_templates.py:207
msgid "Scroll Wheel Smooth Scrolling"
msgstr "Mjuk rullning med rullhjulet"

#: lib/logitech_receiver/settings_templates.py:208
#: lib/logitech_receiver/settings_templates.py:455
#: lib/logitech_receiver/settings_templates.py:484
msgid "High-sensitivity mode for vertical scroll with the wheel."
msgstr "Högkänsligt läge för vertikal rullning med hjulet."

#: lib/logitech_receiver/settings_templates.py:215
msgid "Side Scrolling"
msgstr "Sidorullning"

#: lib/logitech_receiver/settings_templates.py:217
msgid ""
"When disabled, pushing the wheel sideways sends custom button events\n"
"instead of the standard side-scrolling events."
msgstr ""
"När detta är inaktiverat skickas anpassade knapphändelser när hjulet trycks åt sidan\n"
"i stället för vanliga händelser för sidorullning."

#: lib/logitech_receiver/settings_templates.py:227
msgid "Sensitivity (DPI - older mice)"
msgstr "Känslighet (DPI – äldre möss)"

#: lib/logitech_receiver/settings_templates.py:228
#: lib/logitech_receiver/settings_templates.py:1064
#: lib/logitech_receiver/settings_templates.py:1092
msgid "Mouse movement sensitivity"
msgstr "Musrörelsekänslighet"

#: lib/logitech_receiver/settings_templates.py:301
msgid "Backlight Timed"
msgstr "Tidsstyrd bakgrundsbelysning"

#: lib/logitech_receiver/settings_templates.py:302
#: lib/logitech_receiver/settings_templates.py:442
msgid "Set illumination time for keyboard."
msgstr "Ställ in hur länge tangentbordets belysning ska vara tänd."

#: lib/logitech_receiver/settings_templates.py:313
msgid "Backlight"
msgstr "Bakgrundsbelysning"

#: lib/logitech_receiver/settings_templates.py:314
msgid "Illumination level on keyboard.  Changes made are only applied in Manual mode."
msgstr "Belysningsnivå på tangentbordet.  Ändringar som görs tillämpas endast i manuellt läge."

#: lib/logitech_receiver/settings_templates.py:346
msgid "Automatic"
msgstr "Automatiskt"

#: lib/logitech_receiver/settings_templates.py:348
msgid "Manual"
msgstr "Manuellt"

#: lib/logitech_receiver/settings_templates.py:350
msgid "Enabled"
msgstr "Aktiverad"

#: lib/logitech_receiver/settings_templates.py:356
msgid "Backlight Level"
msgstr "Bakgrundsbelysningsnivå"

#: lib/logitech_receiver/settings_templates.py:357
msgid "Illumination level on keyboard when in Manual mode."
msgstr "Belysningsnivå på tangentbordet i manuellt läge."

#: lib/logitech_receiver/settings_templates.py:414
msgid "Backlight Delay Hands Out"
msgstr "Fördröjning när händerna tas bort"

#: lib/logitech_receiver/settings_templates.py:415
msgid "Delay in seconds until backlight fades out with hands away from keyboard."
msgstr "Fördröjning i sekunder innan bakgrundsbelysningen tonas ned när händerna tas bort från tangentbordet."

#: lib/logitech_receiver/settings_templates.py:423
msgid "Backlight Delay Hands In"
msgstr "Fördröjning när händerna är nära"

#: lib/logitech_receiver/settings_templates.py:424
msgid "Delay in seconds until backlight fades out with hands near keyboard."
msgstr "Fördröjning i sekunder innan bakgrundsbelysningen tonas ned när händerna är nära tangentbordet."

#: lib/logitech_receiver/settings_templates.py:432
msgid "Backlight Delay Powered"
msgstr "Fördröjning vid extern strömförsörjning"

#: lib/logitech_receiver/settings_templates.py:433
msgid "Delay in seconds until backlight fades out with external power."
msgstr "Fördröjning i sekunder innan bakgrundsbelysningen tonas ned vid extern strömförsörjning."

#: lib/logitech_receiver/settings_templates.py:441
msgid "Backlight (Seconds)"
msgstr "Bakgrundsbelysning (sekunder)"

#: lib/logitech_receiver/settings_templates.py:453
msgid "Scroll Wheel High Resolution"
msgstr "Hög upplösning för rullhjulet"

#: lib/logitech_receiver/settings_templates.py:457
#: lib/logitech_receiver/settings_templates.py:486
msgid "Set to ignore if scrolling is abnormally fast or slow"
msgstr "Ställ in på Ignorera om rullningen är onormalt snabb eller långsam"

#: lib/logitech_receiver/settings_templates.py:464
#: lib/logitech_receiver/settings_templates.py:495
msgid "Scroll Wheel Diversion"
msgstr "Omdirigering av rullhjulet"

#: lib/logitech_receiver/settings_templates.py:466
msgid "Make scroll wheel send LOWRES_WHEEL HID++ notifications (which trigger Solaar rules but are otherwise ignored)."
msgstr "Gör så att rullhjulet skickar LOWRES_WHEEL-aviseringar via HID++ (som utlöser Solaar-regler men annars ignoreras)."

#: lib/logitech_receiver/settings_templates.py:473
msgid "Scroll Wheel Direction"
msgstr "Rullhjulets riktning"

#: lib/logitech_receiver/settings_templates.py:474
msgid "Invert direction for vertical scroll with wheel."
msgstr "Vänd riktningen för vertikal rullning med hjulet."

#: lib/logitech_receiver/settings_templates.py:482
msgid "Scroll Wheel Resolution"
msgstr "Rullhjulsupplösning"

#: lib/logitech_receiver/settings_templates.py:497
msgid "Make scroll wheel send HIRES_WHEEL HID++ notifications (which trigger Solaar rules but are otherwise ignored)."
msgstr "Gör så att rullhjulet skickar HIRES_WHEEL-aviseringar via HID++ (som utlöser Solaar-regler men annars ignoreras)."

#: lib/logitech_receiver/settings_templates.py:506
msgid "Sensitivity (Pointer Speed)"
msgstr "Känslighet (pekarhastighet)"

#: lib/logitech_receiver/settings_templates.py:507
msgid "Speed multiplier for mouse (256 is normal multiplier)."
msgstr "Hastighetsmultiplikator för musen (256 är normalvärdet)."

#: lib/logitech_receiver/settings_templates.py:517
msgid "Thumb Wheel Diversion"
msgstr "Omdirigering av tumhjulet"

#: lib/logitech_receiver/settings_templates.py:519
msgid "Make thumb wheel send THUMB_WHEEL HID++ notifications (which trigger Solaar rules but are otherwise ignored)."
msgstr "Gör så att tumhjulet skickar THUMB_WHEEL-aviseringar via HID++ (som utlöser Solaar-regler men annars ignoreras)."

#: lib/logitech_receiver/settings_templates.py:528
msgid "Thumb Wheel Direction"
msgstr "Tumhjulets riktning"

#: lib/logitech_receiver/settings_templates.py:529
msgid "Invert thumb wheel scroll direction."
msgstr "Vänd tumhjulets rullningsriktning."

#: lib/logitech_receiver/settings_templates.py:549
msgid "Onboard Profiles"
msgstr "Inbyggda profiler"

#: lib/logitech_receiver/settings_templates.py:550
msgid "Enable an onboard profile, which controls report rate, sensitivity, and button actions"
msgstr "Aktivera en inbyggd profil som styr rapporteringsfrekvens, känslighet och knappfunktioner"

#: lib/logitech_receiver/settings_templates.py:594
#: lib/logitech_receiver/settings_templates.py:627
msgid "Report Rate"
msgstr "Rapportfrekvens"

#: lib/logitech_receiver/settings_templates.py:596
#: lib/logitech_receiver/settings_templates.py:629
msgid "Frequency of device movement reports"
msgstr "Frekvens för enhetens rörelserapporter"

#: lib/logitech_receiver/settings_templates.py:596
#: lib/logitech_receiver/settings_templates.py:629
#: lib/logitech_receiver/settings_templates.py:1064
#: lib/logitech_receiver/settings_templates.py:1092
#: lib/logitech_receiver/settings_templates.py:1471
#: lib/logitech_receiver/settings_templates.py:1502
msgid "May need Onboard Profiles set to Disable to be effective."
msgstr "Det kan krävas att Inbyggda profiler inaktiveras för att inställningen ska få effekt."

#: lib/logitech_receiver/settings_templates.py:657
msgid "Divert crown events"
msgstr "Omdirigera kronhändelser"

#: lib/logitech_receiver/settings_templates.py:658
msgid "Make crown send CROWN HID++ notifications (which trigger Solaar rules but are otherwise ignored)."
msgstr "Gör så att kronan skickar CROWN-aviseringar via HID++ (som utlöser Solaar-regler men annars ignoreras)."

#: lib/logitech_receiver/settings_templates.py:666
msgid "Crown smooth scroll"
msgstr "Mjuk rullning med kronan"

#: lib/logitech_receiver/settings_templates.py:667
msgid "Set crown smooth scroll"
msgstr "Aktivera mjuk rullning med kronan"

#: lib/logitech_receiver/settings_templates.py:675
msgid "Divert G and M Keys"
msgstr "Omdirigera G- och M-tangenterna"

#: lib/logitech_receiver/settings_templates.py:676
msgid "Make G and M keys send HID++ notifications (which trigger Solaar rules but are otherwise ignored)."
msgstr "Gör så att G- och M-tangenterna skickar aviseringar via HID++ (som utlöser Solaar-regler men annars ignoreras)."

#: lib/logitech_receiver/settings_templates.py:690
msgid "Scroll Wheel Ratcheted"
msgstr "Rullhjulets spärrläge"

#: lib/logitech_receiver/settings_templates.py:691
msgid "Switch the mouse wheel between speed-controlled ratcheting and always freespin."
msgstr "Växla mushjulet mellan hastighetsstyrt spärrläge och ständig fri rullning."

#: lib/logitech_receiver/settings_templates.py:693
msgid "Freespinning"
msgstr "Fri rullning"

#: lib/logitech_receiver/settings_templates.py:693
msgid "Ratcheted"
msgstr "Spärrläge"

#: lib/logitech_receiver/settings_templates.py:700
msgid "Scroll Wheel Ratchet Speed"
msgstr "Rullningshjulets spärrhastighet"

#: lib/logitech_receiver/settings_templates.py:702
msgid ""
"Use the mouse wheel speed to switch between ratcheted and freespinning.\n"
"The mouse wheel is always ratcheted at 50."
msgstr ""
"Använd mushjulets hastighet för att växla mellan spärrläge och fri rullning.\n"
"Mushjulet är alltid i spärrläge vid 50."

#: lib/logitech_receiver/settings_templates.py:752
msgid "Scroll Wheel Ratchet Torque"
msgstr "Vridmoment för rullhjulsspärr"

#: lib/logitech_receiver/settings_templates.py:753
msgid "Change the torque needed to overcome the ratchet."
